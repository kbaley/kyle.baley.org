---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatPostDate } from "../lib/archive";
import { getFeaturedWriting, getLocalWritingItems } from "../lib/writing";

const services = [
  {
    title: "Legacy .NET Modernization",
    body: "Modernize older systems in ways that reduce risk, respect delivery commitments, and leave the day-to-day team with code they can actually maintain."
  },
  {
    title: "Practical Architecture & Technical Leadership",
    body: "Clarify boundaries, guide tradeoffs, and shape solutions around the people who will build, support, and use them every day."
  },
  {
    title: "Azure, Docker, CI/CD, DevOps",
    body: "Improve repeatability across cloud and on-premise environments with deployment workflows that make releases calmer and more predictable."
  },
  {
    title: "Blazor, ASP.NET Core, React, JavaScript",
    body: "Build focused web applications with steady attention to usability, testability, long-term maintenance, and the business workflows behind the screens."
  },
  {
    title: "Cross-Industry Business Systems",
    body: "Work through domain-heavy systems across fintech, telecommunications, health care, transportation, lending, insurance, and other operational environments."
  },
  {
    title: "AI-Assisted Engineering Workflows",
    body: "Use AI tools pragmatically to accelerate implementation, review, documentation, and refactoring without outsourcing judgment."
  },
  {
    title: "Enterprise Applications",
    body: "Support on-premise and cloud-hosted business systems with a bias toward reliability, observability, and clear ownership."
  },
  {
    title: "Technical Translation",
    body: "Move easily between engineers, customers, and stakeholders so the team solves the right problem in terms everyone can understand."
  }
];

const workingPrinciples = [
  {
    title: "Incremental Modernization",
    body: "Prefer steady, reversible improvements over risky rewrites. Stabilize the parts that matter, create room for change, and keep delivery moving while the system gets healthier."
  },
  {
    title: "Maintainability for the Actual Team",
    body: "Design around the capabilities, constraints, and daily realities of the people who will operate the system. A clever solution that the team cannot comfortably own is unfinished work."
  },
  {
    title: "Clear Decision Logs",
    body: "Capture architectural and delivery decisions where the team can find them, with as much automation as practical. Good context reduces repeated debates and makes future tradeoffs easier."
  },
  {
    title: "Sustainable Processes",
    body: "Build release, support, and development habits that people can keep using after the urgent project phase passes. The best process is boring enough to survive a busy Tuesday."
  },
  {
    title: "Pragmatic Tooling",
    body: "Use tools because they reduce friction, reveal risk, or improve reliability. Automation, AI assistance, Docker, CI/CD, and documentation all earn their place by helping real work flow."
  }
];

const clients = [
  { name: "Verizon", logo: "/assets/logo-verizon.svg", className: "verizon" },
  { name: "Marriott International", logo: "/assets/logo-marriott-international.svg", className: "marriott" },
  { name: "SLB", logo: "/assets/logo-slb.svg", className: "slb" },
  { name: "CN Rail", logo: "/assets/logo-cn-rail.svg", className: "cn" }
];

const industries = [
  "Finance & Lending",
  "Telecommunications",
  "Education",
  "Transportation",
  "Energy",
  "Hospitality"
];

const localWriting = getLocalWritingItems(await getCollection("writing"));
const featuredWriting = getFeaturedWriting(localWriting);
---

<BaseLayout
  title="Modernizing Legacy .NET Systems Without Disrupting Delivery"
  description="Kyle Baley helps teams modernize legacy .NET systems, build practical maintainable applications, improve architecture, and ship reliable software without losing delivery momentum."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Remote contract engineering · Fractional technical leadership</p>
        <h1>Modernizing Legacy .NET Systems Without Disrupting Delivery</h1>
        <p class="lead">
          I help teams stabilize and modernize business-critical software with practical architecture,
          maintainable .NET applications, and enough communication to keep technical teams,
          customers, and delivery goals aligned.
        </p>
        <div class="actions">
          <a class="button" href="mailto:kyle@baley.org">Start a Conversation</a>
          <a class="text-link" href="https://www.linkedin.com/in/kylebaley/">LinkedIn</a>
          <a class="text-link" href="https://github.com/kbaley">GitHub</a>
          <a class="text-link" href="/writing/">Writing</a>
        </div>
      </div>
      <div class="hero-media" aria-label="Kyle Baley speaking at a software conference">
        <img src="/assets/presenting.jpg" alt="Kyle Baley presenting on stage at a software conference" />
      </div>
    </div>
    <div class="container">
      <figure class="quote-panel">
        <blockquote>
          "We're stuck with technology when what we really want is just stuff that works."
        </blockquote>
        <figcaption>Douglas Adams</figcaption>
      </figure>
    </div>
    <div class="container proof-row" aria-label="Professional highlights">
      <div class="proof-item"><strong>25+ years</strong><span>Software engineering and consulting experience.</span></div>
      <div class="proof-item"><strong>Conference speaker</strong><span>Experienced speaker at software development conferences and community events.</span></div>
      <div class="proof-item"><strong>Technical translator</strong><span>Comfortable with developers, customers, and business stakeholders.</span></div>
    </div>
    <div class="container">
      <article class="book-feature">
        <img src="/assets/brownfield-book-cover.png" alt="Cover of Brownfield Application Development in .NET" loading="lazy" />
        <div>
          <p class="eyebrow">Published author</p>
          <h2>Co-author of Brownfield Application Development in .NET</h2>
          <p>
            Published by Manning, the book focuses on practical techniques for improving inherited
            applications: adding useful process, reducing pain points, separating concerns, and making
            existing systems more maintainable without assuming a clean slate.
          </p>
          <a class="text-link book-link" href="https://www.amazon.com/dp/1933988711">View the book on Amazon</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section alt" id="work">
    <div class="container">
      <div class="section-heading">
        <h2>What I Do</h2>
        <p>
          I work best where technical debt, business rules, customer needs, delivery pressure,
          and practical architecture all meet. The goal is stability first, modernization with intent,
          and systems the people closest to them can understand, operate, and keep improving.
        </p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="card">
            <h3>{service.title}</h3>
            <p>{service.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how-i-work">
    <div class="container">
      <div class="section-heading">
        <h2>How I Work</h2>
        <p>
          I care about systems that work in production and make sense to the people closest to them.
          That means practical modernization, clear communication, and technical choices that support
          stable delivery instead of adding theater.
        </p>
      </div>
      <div class="principle-grid">
        {workingPrinciples.map((item) => (
          <article class="card principle-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="experience">
    <div class="container">
      <div class="section-heading">
        <h2>Where I’ve Worked</h2>
        <p>
          I’ve spent nearly all of the last 20 years working remotely with distributed teams,
          customer-facing groups, and business stakeholders. The common thread is practical delivery
          across organizations with real operational constraints.
        </p>
      </div>
      <div class="experience-grid">
        <article class="card experience-card">
          <h3>Past Clients</h3>
          <div class="client-grid" aria-label="Selected past clients">
            {clients.map((client) => (
              <div class={`client-logo ${client.className}`} aria-label={client.name}>
                <img src={client.logo} alt={client.name} loading="lazy" />
              </div>
            ))}
          </div>
        </article>
        <article class="card experience-card">
          <h3>Industries</h3>
          <ul class="industry-list">
            {industries.map((industry) => <li>{industry}</li>)}
          </ul>
          <p>
            I’ve worked with organizations of all sizes, from startups finding their footing
            to multinationals coordinating change across large teams and customer bases.
          </p>
        </article>
      </div>
      <div class="remote-note">
        <strong>Remote by default for almost 20 years.</strong>
        <span>
          Comfortable building trust, clarifying decisions, and keeping delivery moving without needing everyone in the same room.
        </span>
      </div>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="container">
      <div class="section-heading">
        <h2>Writing</h2>
        <p>
          Recent posts and articles published elsewhere, with the older blog preserved separately
          as an archive instead of mixed into the current work.
        </p>
      </div>
      <div class="writing-preview">
        {featuredWriting.map((post) => (
          <article class="writing-card">
            <div class="writing-card-meta">
              <span>{post.category}</span>
              <time datetime={post.date.toISOString()}>{formatPostDate(post.date)}</time>
            </div>
            <h3>
              <a href={post.url}>{post.title}</a>
            </h3>
            <p>{post.summary}</p>
            <div class="writing-card-footer">
              <span>{post.source}</span>
              {post.isExternal && <span>Published elsewhere</span>}
            </div>
          </article>
        ))}
      </div>
      <div class="writing-actions">
        <a class="button" href="/writing/">View Writing</a>
        <a class="text-link" href="/writing/archive/">Browse Legacy Archive</a>
      </div>
    </div>
  </section>
</BaseLayout>
